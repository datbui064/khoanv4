@page "/category/{id:int}/{type}"
@using KhoaNVCB_Client.Models
@using KhoaNVCB_Client.Services
@inject PostService PostService
@inject CategoryService CategoryService

<PageTitle>@GetTypeName(type) - @currentCategory?.CategoryName</PageTitle>

<div class="container py-5" @key="id">
    <div class="row g-5">
        @* CỘT TRÁI: DANH SÁCH BÀI VIẾT *@
        <div class="col-lg-8">
            <div class="category-header mb-4">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-2">
                        <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                        <li class="breadcrumb-item active text-danger">@GetTypeName(type)</li>
                    </ol>
                </nav>
                <h2 class="fw-bold text-uppercase ps-3 border-start border-4 border-danger">
                    @currentCategory?.CategoryName
                </h2>
            </div>

            @* --- BẢNG LỌC LINH HOẠT --- *@
            <div class="advanced-filter-panel mb-4 p-3 bg-white shadow-sm rounded-4 border">
                <div class="row g-3 align-items-end">
                    @* Kiểm tra nếu type có chứa chữ "law" (không phân biệt hoa thường) *@
                    @if (type?.Contains("law", StringComparison.OrdinalIgnoreCase) == true)
                    {
                        <div class="col-lg-6 col-md-12">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-clock-history text-navy-blue"></i>
                                <span class="fw-bold small text-uppercase">Giai đoạn:</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn-filter-pill @(selectedYearType == null ? "active" : "")"
                                        @onclick='() => ApplyYearFilter(null)'>
                                    Tất cả
                                </button>
                                <button class="btn-filter-pill @(selectedYearType == 1 ? "active" : "")"
                                        @onclick='() => ApplyYearFilter(1)'>
                                    2000-2018
                                </button>
                                <button class="btn-filter-pill @(selectedYearType == 2 ? "active" : "")"
                                        @onclick='() => ApplyYearFilter(2)'>
                                    2018-2025
                                </button>
                                <button class="btn-filter-pill @(selectedYearType == 3 ? "active" : "")"
                                        @onclick='() => ApplyYearFilter(3)'>
                                    2025-Nay
                                </button>
                            </div>
                        </div>
                    }

                    <div class="@(type == "laws" ? "col-lg-2 col-md-4" : "col-lg-4 col-md-4")">
                        <label class="small fw-bold text-secondary mb-1">SẮP XẾP</label>
                        <select class="form-select form-select-sm shadow-none" @bind="sortBy" @bind:after="ExecuteClientFilter">
                            <option value="date_desc">Mới nhất</option>
                            <option value="date_asc">Cũ nhất</option>
                            <option value="title_asc">Tiêu đề A-Z</option>
                        </select>
                    </div>

                    <div class="@(type == "laws" ? "col-lg-4 col-md-8" : "col-lg-8 col-md-8")">
                        <label class="small fw-bold text-secondary mb-1">TÌM KIẾM</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control shadow-none" placeholder="Từ khóa..."
                                   @bind="localSearchTerm" @bind:event="oninput" @onkeyup="ExecuteClientFilter" />
                        </div>
                    </div>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="text-center py-5"><div class="spinner-grow text-danger"></div></div>
            }
            else if (filteredPosts == null || !filteredPosts.Any())
            {
                <div class="text-center py-5 bg-white shadow-sm rounded-4 border">
                    <p class="text-muted">Không tìm thấy nội dung phù hợp.</p>
                </div>
            }
            else
            {
                <div class="list-container">
                    @foreach (var post in filteredPosts)
                    {
                        <div class="card mb-3 border-0 shadow-sm post-list-card overflow-hidden">
                            <div class="row g-0 align-items-center">
                                <div class="col-3 col-md-2 p-2">
                                    <div class="ratio ratio-1x1 overflow-hidden rounded-3 border">
                                        <img src="@(string.IsNullOrEmpty(post.ImageUrl) ? "images/Logo_hoc_vien_ANND.png" : post.ImageUrl)" class="object-fit-cover" />
                                    </div>
                                </div>
                                <div class="col-9 col-md-10">
                                    <div class="card-body py-2 px-3">
                                        <a href="/post/@post.PostId" class="text-decoration-none stretched-link">
                                            <h5 class="card-title fw-bold text-dark mb-1 fs-6 line-clamp-2">@post.Title</h5>
                                        </a>
                                        <p class="card-text text-muted small mb-2 d-none d-md-block line-clamp-1">@post.Summary</p>
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i> @post.CreatedDate?.ToString("dd/MM/yyyy")</span>
                                            @if (post.YearType.HasValue && post.YearType != 0)
                                            {
                                                <span class="badge bg-navy-blue text-white" style="font-size: 0.65rem;">
                                                    @(post.YearType switch
                                                    {
                                                        1 => "2000-2018",
                                                        2 => "2018-2025",
                                                        3 => "2025-Nay",
                                                        _ => $"Giai đoạn {post.YearType}"
                                                    })
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* CỘT PHẢI (SIDEBAR) *@
        <div class="col-lg-4">
            <div class="sticky-top" style="top: 2rem;">
                <div class="modern-sidebar p-4 bg-white shadow-sm rounded-4 border-top border-4 border-danger">
                    <h6 class="fw-bold mb-3 text-uppercase border-bottom pb-2">Chuyên mục chuyên môn</h6>
                    <div class="category-stack d-flex flex-column gap-2">
                        @if (categories != null)
                        {
                            @foreach (var cat in categories.Where(c => c.ParentId == null && c.CategoryName != "Tuyên Truyền" && c.CategoryName != "Video"))
                            {
                                <a href="/category/@cat.CategoryId/@type" class="category-link @(cat.CategoryId == id ? "active" : "")">
                                    <span class="small fw-bold">@cat.CategoryName</span>
                                    <i class="bi bi-chevron-right small"></i>
                                </a>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --navy-blue: #1a237e;
    }

    .bg-navy-blue {
        background-color: var(--navy-blue);
    }

    .text-navy-blue {
        color: var(--navy-blue);
    }

    .advanced-filter-panel {
        border-top: 3px solid var(--navy-blue) !important;
    }

    .btn-filter-pill {
        border: 1px solid #dee2e6;
        background: white;
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        color: #555;
        transition: 0.2s;
    }

        .btn-filter-pill:hover {
            border-color: var(--navy-blue);
            color: var(--navy-blue);
        }

        .btn-filter-pill.active {
            background: var(--navy-blue);
            border-color: var(--navy-blue);
            color: white;
        }

    .post-list-card {
        transition: 0.3s;
    }

        .post-list-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 15px rgba(0,0,0,0.1) !important;
        }

    .category-link {
        display: flex;
        justify-content: space-between;
        padding: 12px;
        border-radius: 8px;
        text-decoration: none;
        color: #444;
        background: #f8f9fa;
        transition: 0.3s;
    }

        .category-link:hover {
            background: #fff;
            color: #dc3545;
            padding-left: 18px;
        }

        .category-link.active {
            background: #dc3545;
            color: #fff !important;
        }

    .line-clamp-1 {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
@code {
    [Parameter] public int id { get; set; }
    [Parameter] public string type { get; set; } = "articles";

    private bool isLoading = true;
    private CategoryDto? currentCategory;
    private List<CategoryDto>? categories;
    private List<PostDto>? allPosts;
    private List<PostDto>? filteredPosts;

    private int? selectedYearType = null;
    private string localSearchTerm = "";
    private string sortBy = "date_desc";

    private void ApplyYearFilter(int? yearId)
    {
        selectedYearType = yearId;
        ExecuteClientFilter();
    }

    private void ExecuteClientFilter()
    {
        if (allPosts == null) return;

        // 1. Luôn bắt đầu từ danh sách gốc
        var query = allPosts.AsEnumerable();

        // 2. Lọc theo Giai đoạn (YearType)
        // Lưu ý: Chỉ lọc nếu selectedYearType có giá trị (người dùng bấm nút)
        if (selectedYearType.HasValue)
        {
            query = query.Where(x => x.YearType == selectedYearType.Value);
        }

        // 3. Lọc theo Tìm kiếm
        if (!string.IsNullOrEmpty(localSearchTerm))
        {
            var term = localSearchTerm.Trim();
            query = query.Where(x =>
                (x.Title != null && x.Title.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (x.Summary != null && x.Summary.Contains(term, StringComparison.OrdinalIgnoreCase)));
        }

        // 4. Sắp xếp
        query = sortBy switch
        {
            "date_asc" => query.OrderBy(x => x.CreatedDate),
            "title_asc" => query.OrderBy(x => x.Title),
            _ => query.OrderByDescending(x => x.CreatedDate)
        };

        // 5. QUAN TRỌNG: Phải .ToList() để tạo tham chiếu mới cho filteredPosts
        filteredPosts = query.ToList();

        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        allPosts = null;
        filteredPosts = null;
        selectedYearType = null;
        localSearchTerm = "";

        if (categories == null)
            categories = await CategoryService.GetAllAsync();

        currentCategory = categories?.FirstOrDefault(c => c.CategoryId == id);

        if (currentCategory != null)
        {
            var result = await PostService.GetPublicPostsPagedAsync(
                page: 1, pageSize: 1000, searchTerm: null, categoryName: null, sourceType: type, sortBy: "date_desc"
            );

            if (result?.Items != null)
            {
                // Mapping dữ liệu và ép kiểu an toàn
                allPosts = result.Items.Select(x => new PostDto
                    {
                        PostId = x.PostId,
                        Title = x.Title ?? "Không có tiêu đề",
                        Summary = x.Summary ?? "",
                        ImageUrl = x.ImageUrl,
                        SourceType = x.SourceType,
                        CreatedDate = x.CreatedDate,
                        YearType = x.YearType, // Nếu Log vẫn null, hãy kiểm tra lại API
                        CategoryName = x.CategoryName ?? ""
                    }).ToList();

                // Chạy hàm lọc lần đầu để gán dữ liệu vào filteredPosts
                ExecuteClientFilter();
            }
        }

        isLoading = false;
        StateHasChanged();
    }

    private string GetTypeName(string t) => t?.ToLower() switch
    {
        "articles" => "Tin tức",
        "videos" => "Video",
        "laws" or "law" => "Quy định pháp luật",
        "documents" => "Văn bản liên quan",
        _ => "Nội dung"
    };
}   