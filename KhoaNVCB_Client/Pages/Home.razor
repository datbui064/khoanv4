    private List<PostDto>? recentPosts;
    private List<CategoryDto>? categories;
    private bool isLoading = true;
    private bool showAllFaculty = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                isLoading = true;
                // StateHasChanged(); // Không bắt buộc ở đầu vì cuối cùng đã có

                // 1. Gọi song song 2 task
                // Dùng GetPublicPostsPagedAsync vì nó trả về PagedResultDto chứa Items
                var categoriesTask = CategoryService.GetAllAsync();
                var postsTask = PostService.GetPublicPostsPagedAsync(
                    page: 1,
                    pageSize: 3,
                    searchTerm: null,
                    categoryName: null,
                    sortBy: "newest" // Đảm bảo đúng tham số sortBy của bạn
                );

                await Task.WhenAll(categoriesTask, postsTask);

                // 2. Xử lý Categories
                var allCategories = await categoriesTask;
                if (allCategories != null)
                {
                    categories = allCategories
                       .Where(c => 
            !c.CategoryName.Equals("Tuyên truyền", StringComparison.OrdinalIgnoreCase) && 
            !c.CategoryName.Equals("Video", StringComparison.OrdinalIgnoreCase)) // THÊM DÒNG NÀY
        .ToList();
                }

                // 3. Xử lý Bài viết (Posts)
                var result = await postsTask;
                if (result != null && result.Items != null)
                {
                    // Ép kiểu từ PostListItemDto sang PostDto nếu cần,
                    // hoặc sửa biến recentPosts thành List<PostListItemDto>
                    recentPosts = result.Items.Select(i => new PostDto
                        {
                            PostId = i.PostId,
                            Title = i.Title,
                            Summary = i.Summary,
                            ImageUrl = i.ImageUrl,
                            CategoryName = i.CategoryName,
                            CreatedDate = i.CreatedDate
                        }).ToList();
                }
                else
                {
                    recentPosts = new List<PostDto>();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Lỗi tại Index: {ex.Message}");
                recentPosts = new List<PostDto>(); // Tránh null để giao diện không crash
            }
            finally
            {
                isLoading = false;
                StateHasChanged(); // Cập nhật lại UI sau khi đã có dữ liệu
            }
        }
 
    }

